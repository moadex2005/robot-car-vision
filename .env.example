# Copy this file to .env and put your own key after the equals sign.
# The .env file stays on this laptop: it is never committed and never pasted into a chat.
ANTHROPIC_API_KEY=

# Optional: a Hugging Face token (it needs the "Make calls to Inference Providers" permission).
# Auto-discover uses it (a small hosted model that names what is in view), and so do the
# hosted voice and hosted listening.
HF_TOKEN=

# Optional: a password of your own, 8 characters or more, for opening the page on a phone
# (phone_door in config.yaml). Without it the phone door stays shut.
PAGE_PASSWORD=
